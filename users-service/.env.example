PORT=3001
HOST=0.0.0.0
# Docker Compose exposes the self-managed MongoDB Search replica set on port 27018.
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27018/careerCoachDB?directConnection=true
MONGO_KEY_PATH=none
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.0-flash
GEMINI_MODEL=gemini-3.0-flash
GEMINI_API_KEY=
PROFILE_EMBEDDING_MODEL=gemini-embedding-001
PROFILE_EMBEDDING_DIMENSIONS=3072
JWT_ACCESS_SECRET=veryVerySecret
JWT_REFRESH_SECRET=notSoSecret
JWT_ACCESS_EXPIRES_IN_SECONDS=60
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
# Must match chat-service, roadmap-service, and job-service for server-to-server user context.
INTERNAL_SERVICE_API_KEY=local-dev-internal-service-key
REFRESH_TOKEN_COOKIE=refreshToken
S3_BUCKET=video-editor
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_UPLOAD_PREFIX=uploads
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenTelemetry tracing (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENVIRONMENT=local
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_CONTENT_MAX_CHARS=8000
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
