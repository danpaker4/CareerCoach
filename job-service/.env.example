PORT=3003
HOST=0.0.0.0
# Docker Compose exposes the self-managed MongoDB Search replica set on port 27018.
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27018/careerCoachDB?directConnection=true
MONGO_KEY_PATH=none
THEIRSTACK_API_KEY=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
LLM_MODEL=llama3
# Required for job and query embeddings; also used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
JOB_EMBEDDING_MODEL=gemini-embedding-001
JOB_EMBEDDING_DIMENSIONS=3072
JOB_VECTOR_INDEX_NAME=jobs_search_embedding_vector_index
JOB_VECTOR_INDEX_READY_TIMEOUT_MS=120000
JOBS_VECTOR_SEARCH_ENABLED=false
USERS_SERVICE_BASE_URL=http://127.0.0.1:3001
INTERNAL_SERVICE_API_KEY=local-dev-internal-service-key

# OpenTelemetry tracing (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENVIRONMENT=local
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_CONTENT_MAX_CHARS=8000
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
