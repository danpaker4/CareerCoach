# Production template for the college VM. Copy to roadmap-service.env (never commit) and fill secrets.
PORT=3005
HOST=0.0.0.0
NODE_ENV=production

MONGO_CONNECTION_STRING=mongodb://admin:<mongo-password-url-encoded>@host.docker.internal:21771/careerCoachDB?authSource=admin&directConnection=true
MONGO_KEY_PATH=none

USERS_SERVICE_BASE_URL=http://users-service:3001
JOB_SERVICE_BASE_URL=http://job-service:3003
CHAT_SERVICE_BASE_URL=http://chat-service:3002
INTERNAL_SERVICE_API_KEY=

# Roadmap generation runs on Gemini (no Basic Auth support for the college gateway here).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=
OLLAMA_MODEL=
CUSTOM_LLM_URL=
EMBEDDING_MODEL=text-embedding-004
CUSTOM_EMBEDDING_URL=
CAREER_DIRECTION_VECTOR_INDEX_NAME=career_direction_vector_index

ROADMAP_DETERMINISTIC_CORE_ENABLED=true
ROADMAP_AI_POLISH_ENABLED=false
ROADMAP_STRUCTURED_EVIDENCE_ENABLED=true
ROADMAP_MEASURABLE_COMPLETION_ENABLED=true

OTEL_ENABLED=true
OTEL_SERVICE_NAME=careercoach.roadmap-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENVIRONMENT=production
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_CONTENT_MAX_CHARS=8000
