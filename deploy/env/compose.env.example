# Copy to the repo root as `.env` on the VM (next to docker-compose.prod.yml). Never commit the real file.

# MinIO credentials - generate strong values; must match S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY in users-service.env.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=careercoach-uploads

# LiteLLM proxy. LITELLM_MASTER_KEY must match LITELLM_API_KEY in chat-service.env.
LITELLM_MASTER_KEY=
# Gemini key used by the LiteLLM fallback route (and by the other services).
GEMINI_API_KEY=
# College LLM gateway. Only its IP vhost answers (the hostname 403s), and it requires
# HTTP Basic Auth passed as an explicit header (LiteLLM rejects URL userinfo).
#   COLLEGE_LLM_AUTH_HEADER="Basic $(printf 'user:password' | base64)"
COLLEGE_LLM_BASE_URL=http://10.10.248.41
COLLEGE_LLM_AUTH_HEADER=
# Tiny last-resort local model pulled into the ollama container.
OLLAMA_LOCAL_MODEL=llama3.2:1b

# Langfuse Cloud (LLM observability). Keys from cloud.langfuse.com -> Settings -> API Keys.
# The OTel collector exports spans tagged langfuse.export=true to this project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# MongoDB (atlas-local image: mongod + mongot, provides $vectorSearch).
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
