# Production template for the college VM. Copy to job-service.env (never commit) and fill secrets.
PORT=3003
HOST=0.0.0.0
NODE_ENV=production

MONGO_CONNECTION_STRING=mongodb://admin:<mongo-password-url-encoded>@host.docker.internal:21771/careerCoachDB?authSource=admin&directConnection=true
MONGO_KEY_PATH=none

USERS_SERVICE_BASE_URL=http://users-service:3001
INTERNAL_SERVICE_API_KEY=

# Job enrichment + embeddings run on Gemini (this service has no Basic Auth support
# for the college gateway; only chat-service reaches it, via the LiteLLM proxy).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
JOB_EMBEDDING_MODEL=gemini-embedding-001
JOB_EMBEDDING_DIMENSIONS=3072

# Vector search needs MongoDB + mongot (Atlas-style $vectorSearch). The VM's host
# MongoDB has neither, so keep this false until a mongo+mongot pair is deployed.
JOB_VECTOR_INDEX_NAME=jobs_search_embedding_vector_index
JOB_VECTOR_INDEX_READY_TIMEOUT_MS=120000
JOBS_VECTOR_SEARCH_ENABLED=false

# Jobs ETL. NOTE: the poller calls are commented out in application code
# (job-service/src/poller/job-poller.ts), so setting this key alone does not start it.
THEIRSTACK_API_KEY=

OTEL_ENABLED=true
OTEL_SERVICE_NAME=careercoach.job-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_CONTENT_MAX_CHARS=8000
