# Production template for the college VM. Copy to chat-service.env (never commit) and fill secrets.
# Used by both the chat-service and chat-worker containers.
PORT=3002
HOST=0.0.0.0
NODE_ENV=production

MONGO_CONNECTION_STRING=mongodb://admin:<mongo-password-url-encoded>@host.docker.internal:21771/careerCoachDB?authSource=admin&directConnection=true
MONGO_KEY_PATH=none

# Compose-internal service DNS
USERS_SERVICE_BASE_URL=http://users-service:3001
JOB_SERVICE_BASE_URL=http://job-service:3003
ROADMAP_SERVICE_BASE_URL=http://roadmap-service:3005
RABBITMQ_URL=amqp://rabbitmq:5672
CHAT_REQUEST_QUEUE_NAME=chat.message.requests
CHAT_EVENTS_EXCHANGE_NAME=chat.request.events
INTERNAL_SERVICE_API_KEY=

# All chat completions go through the LiteLLM proxy container.
# Routing and the fallback chain live in litellm-config.prod.yaml, not here.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=
LITELLM_MODEL=chat-default

# Embeddings (optional; leave empty to disable vector features)
CUSTOM_EMBEDDING_URL=
CAREER_DIRECTION_VECTOR_INDEX_NAME=career_direction_vector_index

OTEL_ENABLED=true
OTEL_SERVICE_NAME=careercoach.chat-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENVIRONMENT=production
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_CONTENT_MAX_CHARS=8000
