# Production template for the college VM. Copy to users-service.env (never commit) and fill secrets.
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# VM host MongoDB (port 21771). URL-encode special chars in the password (@ -> %40).
MONGO_CONNECTION_STRING=mongodb://admin:<mongo-password-url-encoded>@host.docker.internal:21771/careerCoachDB?authSource=admin&directConnection=true
MONGO_KEY_PATH=none

# CV extraction + profile embeddings run on Gemini.
# (The college gateway needs HTTP Basic Auth, which this service does not implement;
#  only chat-service reaches it, through the LiteLLM proxy.)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
PROFILE_EMBEDDING_MODEL=gemini-embedding-001
PROFILE_EMBEDDING_DIMENSIONS=3072

# Auth - generate fresh random values (openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
REFRESH_TOKEN_COOKIE=refreshToken
# Must match all other services
INTERNAL_SERVICE_API_KEY=

# MinIO (compose service). Must match MINIO_ROOT_USER/PASSWORD in the compose .env.
S3_BUCKET=careercoach-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_UPLOAD_PREFIX=uploads

# OAuth apps (callbacks must point at https://careercoach.cs.colman.ac.il)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Tracing -> otel-collector -> Jaeger (UI at https://<domain>/jaeger/)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=careercoach.users-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_CONTENT_MAX_CHARS=8000
