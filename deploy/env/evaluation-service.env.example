# Production template for the college VM. Copy to evaluation-service.env (never commit).
PORT=3004
HOST=0.0.0.0
NODE_ENV=production

MONGO_CONNECTION_STRING=mongodb://admin:<mongo-password-url-encoded>@host.docker.internal:21771/careerCoachDB?authSource=admin&directConnection=true

CHAT_SERVICE_BASE_URL=http://chat-service:3002
EVALUATION_USER_ID=evaluation-runner-user
INTERNAL_SERVICE_API_KEY=

# Promptfoo is mounted into the container by docker-compose.prod.yml.
PROMPTFOO_PACKAGE_DIR=/evals/promptfoo
EVALUATION_SERVICE_BASE_URL=http://127.0.0.1:3004
ROADMAP_SERVICE_BASE_URL=http://roadmap-service:3005

OTEL_ENABLED=true
OTEL_SERVICE_NAME=careercoach.evaluation-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENVIRONMENT=production
