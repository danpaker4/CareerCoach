# Production build env. Copy to .env.production (never commit) before `npm run build`.
# All VITE_*_BASE_URL values stay UNSET on purpose: the app then uses same-origin
# relative URLs, and host nginx routes each path prefix to the right service.
VITE_CLIENT_ID=
VITE_LINKEDIN_CLIENT_ID=
# Optional: shows the external Langfuse card on the Management page.
VITE_LANGFUSE_DASHBOARD_URL=
# Promptfoo results viewer, proxied same-origin by nginx (see deploy/nginx/careercoach.conf).
VITE_PROMPTFOO_VIEW_URL=/promptfoo-view/
